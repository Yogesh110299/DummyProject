CREATE OR REPLACE PROCEDURE SP_PURGE_PROCESS
AS
    -- Variables for processing
    v_current_date      DATE := TRUNC(SYSDATE);
    v_can_delete        BOOLEAN;
    v_delete_count      NUMBER;
    v_sql_stmt          VARCHAR2(4000);
    v_error_msg         VARCHAR2(4000);
    
    -- Cursor for PURGEAUDIT records where ALLTASKDATAPURGEDFLG = 'N'
    CURSOR c_purgeaudit IS
        SELECT PURGEID
        FROM PURGEAUDIT
        WHERE ALLTASKDATAPURGEDFLG = 'N'
        AND ACTIVE = 'Y';
    
    -- Cursor for checking future dated tasks
    CURSOR c_future_tasks(p_purgeid CHAR) IS
        SELECT COUNT(*)
        FROM PURGETASK
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED > v_current_date;
    
    -- Cursor for checking future dated workpackets
    CURSOR c_future_wrkpkt(p_purgeid CHAR) IS
        SELECT COUNT(*)
        FROM PURGEWORKPKT
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED > v_current_date;
    
    -- Cursor for checking future dated documents
    CURSOR c_future_docs(p_purgeid CHAR) IS
        SELECT COUNT(*)
        FROM PURGEDOC
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED > v_current_date;
    
    -- Cursor for tasks to delete
    CURSOR c_tasks_to_delete(p_purgeid CHAR) IS
        SELECT TSKID
        FROM PURGETASK
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED <= v_current_date
        AND TASKPURGEDFLG = 'N';
    
    -- Cursor for workpackets to delete
    CURSOR c_wrkpkt_to_delete(p_purgeid CHAR) IS
        SELECT PKTID
        FROM PURGEWORKPKT
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED <= v_current_date
        AND WRKPKTPURGEDFLG = 'N';
    
    -- Cursor for documents to delete
    CURSOR c_docs_to_delete(p_purgeid CHAR) IS
        SELECT DOCID
        FROM PURGEDOC
        WHERE PURGEID = p_purgeid
        AND DATECANBEDELETED <= v_current_date
        AND DOCDATAPURGEDFLG = 'N';
    
    -- Cursor for tables to purge
    CURSOR c_purge_tables(p_level VARCHAR2) IS
        SELECT TABLENAME, LOOKUPCOLUMN
        FROM PURGETABLECONFIG
        WHERE ACTIVE = 'Y'
        AND LOOKUPCOLUMN = p_level;

BEGIN
    -- Main loop through PURGEAUDIT records
    FOR r_purge IN c_purgeaudit LOOP
        BEGIN
            -- STEP 1: Check and set pending flags
            
            -- Check for future dated tasks
            FOR r_future IN c_future_tasks(r_purge.PURGEID) LOOP
                IF r_future.count > 0 THEN
                    UPDATE PURGEAUDIT
                    SET DATADELETEPENDFLG = 'Y'
                    WHERE PURGEID = r_purge.PURGEID;
                END IF;
            END LOOP;
            
            -- Check for future dated documents
            FOR r_future IN c_future_docs(r_purge.PURGEID) LOOP
                IF r_future.count > 0 THEN
                    UPDATE PURGEAUDIT
                    SET DOCDELETEPENDFLG = 'Y'
                    WHERE PURGEID = r_purge.PURGEID;
                END IF;
            END LOOP;
            
            -- STEP 2: Delete Task data
            FOR r_task IN c_tasks_to_delete(r_purge.PURGEID) LOOP
                v_can_delete := TRUE;
                
                -- Delete from all related tables
                FOR r_table IN c_purge_tables('TSKID') LOOP
                    BEGIN
                        v_sql_stmt := 'DELETE FROM ' || r_table.TABLENAME || 
                                     ' WHERE TSKID = :1';
                        EXECUTE IMMEDIATE v_sql_stmt USING r_task.TSKID;
                    EXCEPTION
                        WHEN OTHERS THEN
                            v_can_delete := FALSE;
                            v_error_msg := SQLERRM;
                            -- Log error but continue processing
                            DBMS_OUTPUT.PUT_LINE('Error deleting from ' || r_table.TABLENAME || 
                                               ' for TSKID ' || r_task.TSKID || ': ' || v_error_msg);
                    END;
                END LOOP;
                
                -- If all deletes successful, update PURGETASK
                IF v_can_delete THEN
                    UPDATE PURGETASK
                    SET TASKPURGEDFLG = 'Y',
                        DELETEDATE = v_current_date
                    WHERE PURGEID = r_purge.PURGEID
                    AND TSKID = r_task.TSKID;
                END IF;
            END LOOP;
            
            -- STEP 3: Delete Workpacket data
            FOR r_wrkpkt IN c_wrkpkt_to_delete(r_purge.PURGEID) LOOP
                v_can_delete := TRUE;
                
                -- Delete from all related tables
                FOR r_table IN c_purge_tables('PKTID') LOOP
                    BEGIN
                        v_sql_stmt := 'DELETE FROM ' || r_table.TABLENAME || 
                                     ' WHERE PKTID = :1';
                        EXECUTE IMMEDIATE v_sql_stmt USING r_wrkpkt.PKTID;
                    EXCEPTION
                        WHEN OTHERS THEN
                            v_can_delete := FALSE;
                            v_error_msg := SQLERRM;
                            -- Log error but continue processing
                            DBMS_OUTPUT.PUT_LINE('Error deleting from ' || r_table.TABLENAME || 
                                               ' for PKTID ' || r_wrkpkt.PKTID || ': ' || v_error_msg);
                    END;
                END LOOP;
                
                -- If all deletes successful, update PURGEWORKPKT
                IF v_can_delete THEN
                    UPDATE PURGEWORKPKT
                    SET WRKPKTPURGEDFLG = 'Y',
                        DELETEDATE = v_current_date
                    WHERE PURGEID = r_purge.PURGEID
                    AND PKTID = r_wrkpkt.PKTID;
                END IF;
            END LOOP;
            
            -- STEP 4: Delete Document data
            FOR r_doc IN c_docs_to_delete(r_purge.PURGEID) LOOP
                v_can_delete := TRUE;
                
                -- Delete from all related tables
                FOR r_table IN c_purge_tables('DOCID') LOOP
                    BEGIN
                        v_sql_stmt := 'DELETE FROM ' || r_table.TABLENAME || 
                                     ' WHERE DOCID = :1';
                        EXECUTE IMMEDIATE v_sql_stmt USING r_doc.DOCID;
                    EXCEPTION
                        WHEN OTHERS THEN
                            v_can_delete := FALSE;
                            v_error_msg := SQLERRM;
                            -- Log error but continue processing
                            DBMS_OUTPUT.PUT_LINE('Error deleting from ' || r_table.TABLENAME || 
                                               ' for DOCID ' || r_doc.DOCID || ': ' || v_error_msg);
                    END;
                END LOOP;
                
                -- If all deletes successful, update PURGEDOC
                IF v_can_delete THEN
                    UPDATE PURGEDOC
                    SET DOCDATAPURGEDFLG = 'Y',
                        DOCDATADELETEDATE = v_current_date
                    WHERE PURGEID = r_purge.PURGEID
                    AND DOCID = r_doc.DOCID;
                END IF;
            END LOOP;
            
            -- STEP 5: Check if all data has been purged and update PURGEAUDIT
            DECLARE
                v_all_tasks_purged    NUMBER;
                v_all_wrkpkt_purged   NUMBER;
                v_all_docs_purged     NUMBER;
                v_task_count          NUMBER;
                v_doc_count           NUMBER;
            BEGIN
                -- Check if all tasks are purged
                SELECT COUNT(*)
                INTO v_all_tasks_purged
                FROM PURGETASK
                WHERE PURGEID = r_purge.PURGEID
                AND TASKPURGEDFLG = 'N';
                
                -- Check if all workpackets are purged
                SELECT COUNT(*)
                INTO v_all_wrkpkt_purged
                FROM PURGEWORKPKT
                WHERE PURGEID = r_purge.PURGEID
                AND WRKPKTPURGEDFLG = 'N';
                
                -- Check if all documents are purged
                SELECT COUNT(*)
                INTO v_all_docs_purged
                FROM PURGEDOC
                WHERE PURGEID = r_purge.PURGEID
                AND DOCDATAPURGEDFLG = 'N';
                
                -- Get counts of purged items
                SELECT COUNT(*)
                INTO v_task_count
                FROM PURGETASK
                WHERE PURGEID = r_purge.PURGEID
                AND TASKPURGEDFLG = 'Y';
                
                SELECT COUNT(*)
                INTO v_doc_count
                FROM PURGEDOC
                WHERE PURGEID = r_purge.PURGEID
                AND DOCDATAPURGEDFLG = 'Y';
                
                -- Update PURGEAUDIT based on results
                IF v_all_tasks_purged = 0 AND v_all_wrkpkt_purged = 0 AND v_all_docs_purged = 0 THEN
                    UPDATE PURGEAUDIT
                    SET ALLTASKDATAPURGEDFLG = 'Y',
                        ALLDOCSPURGEDFLG = 'Y',
                        NUMTASKSPURGED = v_task_count,
                        NUMDOCSPURGED = v_doc_count,
                        PURGECOMPDATE = TO_NUMBER(TO_CHAR(SYSDATE, 'YYYYMMDD')),
                        PURGECOMPTIME = TO_NUMBER(TO_CHAR(SYSDATE, 'HH24MISS'))
                    WHERE PURGEID = r_purge.PURGEID;
                ELSE
                    -- Update counts even if not all purged
                    UPDATE PURGEAUDIT
                    SET NUMTASKSPURGED = v_task_count,
                        NUMDOCSPURGED = v_doc_count
                    WHERE PURGEID = r_purge.PURGEID;
                END IF;
            END;
            
            -- Commit after each PURGEID
            COMMIT;
            
        EXCEPTION
            WHEN OTHERS THEN
                -- Rollback for this PURGEID and log error
                ROLLBACK;
                v_error_msg := SQLERRM;
                DBMS_OUTPUT.PUT_LINE('Error processing PURGEID ' || r_purge.PURGEID || ': ' || v_error_msg);
        END;
    END LOOP;
    
EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        v_error_msg := SQLERRM;
        RAISE_APPLICATION_ERROR(-20001, 'SP_PURGE_PROCESS failed: ' || v_error_msg);
END SP_PURGE_PROCESS;
/

