# Define file paths
$baseFilePath = "C:\path\to\Base.csv"
$reportFilePath = "C:\path\to\Report.csv"

# Define output file paths
$missingInReportPath = "C:\path\to\recs_present_in_base_but_report.csv"
$missingInBasePath = "C:\path\to\recs_present_in_report_but_base.csv"

# Import CSV files
$baseData = Import-Csv -Path $baseFilePath
$reportData = Import-Csv -Path $reportFilePath

# Identify common columns (Base file columns are the key for comparison)
$baseColumns = $baseData[0].PSObject.Properties.Name
$reportFilteredData = $reportData | Select-Object -Property $baseColumns

# Function to normalize data (Trim spaces, convert to lowercase, handle nulls)
function Normalize-Row {
    param ($row, $columns)
    return ($columns | ForEach-Object { 
        $value = $row.$_
        if ($null -eq $value) { "" } else { $value.ToString().Trim().ToLower() }
    }) -join "|"
}

# Convert each row into a normalized unique identifier using a hashtable
$baseRows = @{}
foreach ($row in $baseData) {
    $normalizedRow = Normalize-Row -row $row -columns $baseColumns
    $baseRows[$normalizedRow] = $row  # Store the full row as value
}

$reportRows = @{}
foreach ($row in $reportFilteredData) {
    $normalizedRow = Normalize-Row -row $row -columns $baseColumns
    $reportRows[$normalizedRow] = $row  # Store the full row as value
}

# Find records present in Base but missing in Report
$missingInReport = $baseData | Where-Object { 
    $rowKey = Normalize-Row -row $_ -columns $baseColumns
    -not $reportRows.ContainsKey($rowKey)
}

# Find records present in Report but missing in Base
$missingInBase = $reportFilteredData | Where-Object { 
    $rowKey = Normalize-Row -row $_ -columns $baseColumns
    -not $baseRows.ContainsKey($rowKey)
}

# Export missing records
$missingInReport | Export-Csv -Path $missingInReportPath -NoTypeInformation -Force -Encoding UTF8
$missingInBase | Export-Csv -Path $missingInBasePath -NoTypeInformation -Force -Encoding UTF8

Write-Host "Comparison completed. Reports generated:"
Write-Host "Records missing in Report: $missingInReportPath"
Write-Host "Records missing in Base: $missingInBasePath"
