function merge_manualentries {
    

    # File paths
    $manualEntriesCsvPath = "C:\MIS_Platform\manualentries_0212.csv"
    $peopleCountCsvPath = "C:\MIS_Platform\people_count_prd.csv"
    $outputCsvPath = "C:\MIS_Platform\output files\people_count_prd.csv"

    # Import CSV files
    $manualEntriesCsv = Import-Csv -Path $manualEntriesCsvPath
    $peopleCountCsv = Import-Csv -Path $peopleCountCsvPath
    
    if (test-path $outputCsvPath) {

        Remove-Item $outputCsvPath

    }
 
    $result = New-Item -Path $outputCsvPath -ItemType File

    # Create a dictionary for manual entries based on Employee_ID
    $manualEntriesMap = @{}
    foreach ($record in $manualEntriesCsv) {
        $manualEntriesMap[$record.Employee_ID] = @{
            Vertical          = $record.Department
            Rebadged_External = $record.Rebadged_External_Hire
        }
    }

    # Merged result array
    $mergedData = @()

    foreach ($peopleCount in $peopleCountCsv) {
        $empId = $peopleCount.UserId  # Match Employee_ID from manual entries with userid in people count

        # Check if empId exists in manualEntries
        $manualData = $manualEntriesMap[$empId]
        
        $Object = New-Object PSObject -Property @{
            Vertical                    = if ($manualData) { $manualData.Vertical } else { $peopleCount.Vertical }
            "Rebadged or External Hire" = if ($manualData) { $manualData.Rebadged_External } else { $peopleCount.Rebadged_External }
            "Report Month"              = $peopleCount."Report Month"
            Status                      = $peopleCount.Status
            UserId                      = $peopleCount.UserId
            "Full Name"                 = $peopleCount."Full Name"
            Title                       = $peopleCount."Title"
            Gender                      = $peopleCount.Gender
            Email                       = $peopleCount.Email
            "Supervisor Employee ID"    = $peopleCount."Supervisor Employee ID"
            HR                          = $peopleCount.HR
            "Business Unit"             = $peopleCount."Business Unit"
            "Pay Grade ID"              = $peopleCount."Pay Grade ID"           
            Location                    = $peopleCount.Location
            "Hire Date"                 = $peopleCount."Hire Date"
            "Address State"             = $peopleCount."Address State"
            "Date of Joining"           = $peopleCount."Date of Joining"
            "Joining Month"             = $peopleCount."Joining Month"
            "Joining Year"              = $peopleCount."Joining Year"
            "Total Experience"          = $peopleCount."Total Experience"
            "Overall Experience"        = $peopleCount."Overall Experience"
            "Type of Hire"              = $peopleCount."Type of Hire"
            Grade                       = $peopleCount.Grade
            "Grade Group"               = $peopleCount."Grade Group"
            Tenure                      = $peopleCount.Tenure
            "Tenure Range"              = $peopleCount."Tenure Range"
            "Date Of Birth"             = $peopleCount."Date Of Birth"
            Department                  = $peopleCount.Department
            YOB                         = $peopleCount.YOB
            Age                         = $peopleCount.Age
            Generation                  = $peopleCount.Generation
            "Age Range"                 = $peopleCount."Age Range"
            Depart                      = $peopleCount.Depart
            "Vendor Flag"               = $peopleCount."Vendor Flag"
        }
        
        $mergedData += $Object
    }

    # Export merged data
    $mergedData | Export-Csv -Path $outputCsvPath -NoTypeInformation -Encoding UTF8 -Force 

    Write-Host "Merge completed. Output saved to: $outputCsvPath"
}

